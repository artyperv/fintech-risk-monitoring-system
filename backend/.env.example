# Copy to `.env` in this directory (`cp .env.example .env`) and adjust.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=riskdb
# Separate database for pytest.
POSTGRES_TEST_DB=riskdb_test

# --- API ---
API_PREFIX=/api/v1
# Set to true to expose OpenAPI and Swagger at {API_PREFIX}/docs
DEBUG=true

# --- Risk evaluation worker (simulated delay before scoring) ---
RISK_EVALUATION_DELAY_SECONDS=2
